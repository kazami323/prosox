# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# project
.DS_Store
.worktrees/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# next dev's auto-generated agent-rules files (disabled via agentRules:
# false in next.config.ts; ignored defensively in case something still
# writes them — a tool-generated CLAUDE.md collides with Claude Code's
# own project-instructions convention)
/AGENTS.md
/CLAUDE.md

# production
/build

# misc
*.pem

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env*.local
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
